# PRIME TIME: SHOWDOWN — daily PRIME NETWORK backup at about 03:30 UTC (also after a missed night).
#   sudo systemctl list-timers prime-backup.timer   when is the next one

[Unit]
Description=Daily PRIME NETWORK backup

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
