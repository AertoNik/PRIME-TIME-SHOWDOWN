# PRIME TIME: SHOWDOWN — settings of the STAGING server (TEMPLATE, no real values).
# → /etc/primetime-staging/pocketbase.env (owner root, group pocketbase, mode 640). docs/ROBOKASSA_SETUP.md.

# This server is staging: it takes ONLY Robokassa's test mode and counts ONLY test purchases.
PRIME_SERVER_ROLE=staging
# off until the owner has saved the test settings in Robokassa and wants the first test payment
PRIME_PAY_MODE=off
# test sales on this server only (the stand-in test prices and test terms of the release)
PRIME_SHOP_SALES=open

# no public registration: the testers' PRIME IDs are made by the administrator
PRIME_REGISTRATION=disabled
PRIME_MAIL_MODE=

# the staging API address (Caddy) and the game the payment pages return to
PRIME_APP_URL=https://STAGING_DOMAIN_PLACEHOLDER
# the game build that talks to THIS server (a test build or a local `npm run dev`), never the public site
PRIME_GAME_URL=
PRIME_ORIGINS=
PRIME_TRUSTED_PROXY_HEADER=X-Forwarded-For

# a fresh 32-character key for THIS server (never the production one): openssl rand -hex 16
PB_ENCRYPTION_KEY=
