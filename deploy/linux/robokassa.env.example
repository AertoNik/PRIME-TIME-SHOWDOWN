# PRIME TIME: SHOWDOWN — Robokassa settings of ONE server (TEMPLATE, no real values).
# Copy to /etc/primetime/robokassa.env ON THE SERVER ONLY:
#   sudo install -m 640 -o root -g pocketbase deploy/linux/robokassa.env.example /etc/primetime/robokassa.env
#   sudo nano /etc/primetime/robokassa.env
# Never in git, never in the game (no VITE_* variable), never in a chat, a screenshot or a document.
# docs/ROBOKASSA_SETUP.md explains every line; docs/PRIME_PAYMENTS.md the safety rules.
#
# A STAGING server (PRIME_SERVER_ROLE=staging, PRIME_PAY_MODE=test) holds ONLY the test passwords.
# The PRODUCTION server (PRIME_SERVER_ROLE=production, PRIME_PAY_MODE=live) holds ONLY the live ones.
# The official site's DEMONSTRATION (production, PRIME_PAY_MODE=demo + PRIME_DEMO_UNTIL) holds ONLY the test
# passwords too — remove them (and end the demonstration: prime-shop demo-end) before live payments start.
# Both sets on one server → the server refuses to take payments (it never picks one by itself).

# The shop's identifier in Robokassa (not a secret).
ROBOKASSA_MERCHANT_LOGIN=primetimeshowdown

# The hash algorithm EXACTLY as saved in the shop's technical settings: md5 | sha256 | sha512.
# Empty = no payments (the server never guesses). RIPEMD160 / SHA1 / SHA384 are not supported here.
ROBOKASSA_HASH_ALGORITHM=

# --- staging (test mode) and the demonstration (demo mode) -------------------------------------------
# «Пароль #1» and «Пароль #2» of the TEST block of the technical settings.
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=

# --- production (live) — leave EMPTY on a staging server -------------------------------------------
# ROBOKASSA_PASSWORD_1=
# ROBOKASSA_PASSWORD_2=
# Password #3 — only for the Refund API (and only with PRIME_PAY_REFUND_API=on).
# ROBOKASSA_PASSWORD_3=
# PRIME_PAY_REFUND_API=

# Optional: accept ResultURL only from these addresses (Robokassa's, from its documentation). The
# signature is checked either way; leave empty unless the owner decides to restrict.
# ROBOKASSA_RESULT_IPS=185.59.216.65,185.59.217.65

# Optional, OFF: send the 54-ФЗ «Receipt» field — only if Robokassa support confirms it is needed for
# «Робочеки СМЗ» (self-employed receipts are made by Robokassa without it).
# ROBOKASSA_RECEIPT=on
