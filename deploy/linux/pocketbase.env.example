# PRIME TIME: SHOWDOWN — PRIME NETWORK server settings (TEMPLATE, no real values).
# install.sh copies it to /etc/primetime/pocketbase.env (owner root, group pocketbase, mode 640)
# and generates PB_ENCRYPTION_KEY. Real values live ONLY on the server and in your private notes —
# never in git, never in the game (no VITE_* variable may hold any of this).

# Who may register: invite_only (closed beta) | disabled | public.
# Anything else, or a missing line, means «disabled». Do NOT use public before the public launch.
PRIME_REGISTRATION=invite_only

# The public HTTPS address of this API (links in the emails point here).
PRIME_APP_URL=https://api.example.com
# Where the «back to the game» button of the email pages leads.
PRIME_GAME_URL=https://primetimeshowdown.online/
# Browser pages allowed to call the API (CORS): scheme + host, no path, no trailing slash, separated
# by commas WITHOUT spaces. The game's own domain first; the old GitHub Pages address stays for pages
# still open there (it redirects to the domain now). Never «*», never http://.
PRIME_ORIGINS=https://primetimeshowdown.online,https://aertonik.github.io
# Caddy passes the visitor's IP in this header (rate limits per visitor, not per proxy).
PRIME_TRUSTED_PROXY_HEADER=X-Forwarded-For

# 1.8.3 PRIME CLOUD 2.0: one active game session per PRIME ID — on when empty or missing.
# «off» is ONLY the emergency switch back to the 1.8.2 save rules (nothing in the database changes).
PRIME_SESSIONS=

# 1.8.4 PUBLIC REGISTRATION & ACCOUNT SAFETY (every line may stay empty — the defaults are safe).
# public registration opens only with real email (PRIME_MAIL_MODE=smtp); otherwise it stays closed.
# The registration challenge (proof of work): 10–24 bits, empty = 18 (about a second on a phone).
PRIME_POW_BITS=
# At most this many letters a day from this server (all kinds together); empty = 90. Keep it under the
# daily limit of your email provider's plan.
PRIME_MAIL_DAILY_CAP=
# A 1.8.4 registration never confirmed by email is deleted after this many days; empty = 7, 0 = never.
PRIME_UNVERIFIED_DAYS=
# Minimum age to register WITHOUT a parent, per country — ONLY ages confirmed by the owner / a lawyer.
# Format: US:13,GB:13 (13…25). A country not listed: 18. Under 13: never (the product rule).
PRIME_AGE_RULES=
# No new PRIME ID from these countries at all (ISO codes, e.g. XX,YY); empty = none.
PRIME_CLOSED_COUNTRIES=
# 1.8.8 PRIME SHOP: «open» lets THIS server sell — and only items the release itself put on sale
# (an approved price, a published offer). Empty = no sales (keep it empty until payments are connected,
# tested and approved by the owner).
PRIME_SHOP_SALES=

# 1.8.8 stage 4 PRIME PAYMENTS (docs/PRIME_PAYMENTS.md, docs/ROBOKASSA_SETUP.md).
# What this server IS: production (also when empty — the safe reading) | staging | dev.
# A production server counts only LIVE purchases; a test payment can never own anything here.
PRIME_SERVER_ROLE=
# What it takes: off (also when empty) | test (staging only: Robokassa's test mode, IsTest=1) | live
# (production only, after the owner's explicit permission) | demo (1.8.8 final: the official site's
# DEMONSTRATION for Robokassa's moderators and every verified PRIME ID — Robokassa's test mode, its own demo
# orders and rights, cosmetics at their approved prices, only the TEST passwords). A wrong combination = no
# payments at all.
PRIME_PAY_MODE=
# demo only, MANDATORY: the demonstration's last day (YYYY-MM-DD, Moscow time; at most 92 days ahead). After it
# the demonstration stops by itself and its rights count for nothing.
PRIME_DEMO_UNTIL=
# Production only: where Robokassa's notifications and returns for TEST-range invoices (staging's) are passed
# on, once the shop's ResultURL / SuccessURL / FailURL point at production. Staging on this VPS: the loopback
# address (never leaves the server). Empty = nothing is passed on.
# PRIME_PAY_RELAY_URL=http://127.0.0.1:8091
# Production only: staging's PUBLIC https address (no path) where the PLAYER is sent back after a TEST-range
# payment (the loopback above is for server notifications only — a browser cannot reach it). A DNS name only:
# never an IP address, localhost or http. Empty = a return page without a redirect.
# PRIME_PAY_RELAY_PUBLIC_URL=https://primetime-showdown-staging.duckdns.org
# The Robokassa settings and passwords are NOT here: /etc/primetime/robokassa.env (template:
# deploy/linux/robokassa.env.example; owner root, group pocketbase, mode 640).

# 32 random characters: PocketBase stores its settings (SMTP password) encrypted with it.
# Generated by install.sh. KEEP A COPY in your private notes: without it the settings cannot be read.
PB_ENCRYPTION_KEY=

# Email. Empty PRIME_MAIL_MODE = no real email leaves the server (the hook refuses to send).
# smtp = send through the provider below (choose it first; do not test with friends' addresses).
PRIME_MAIL_MODE=
PRIME_SENDER_ADDRESS=no-reply@example.com
# values with spaces in double quotes (systemd and the invites script read them the same way)
PRIME_SENDER_NAME="PRIME TIME: SHOWDOWN"
PRIME_SMTP_HOST=
PRIME_SMTP_PORT=587
PRIME_SMTP_USERNAME=
PRIME_SMTP_PASSWORD=
# true only for port 465 (TLS from the start); port 587 upgrades with STARTTLS by itself
PRIME_SMTP_TLS=false
