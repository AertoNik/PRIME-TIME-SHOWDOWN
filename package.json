{
  "name": "prime-time-showdown",
  "private": true,
  "version": "1.8.3-alpha",
  "description": "PRIME TIME: SHOWDOWN — stylized 3D tactical card duel browser game (Alpha 1.8.2 Stage 1: PRIME Cloud closed beta — pre-deployment foundation)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:accounts": "vite --mode accounts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/simulate.ts",
    "audit": "tsx scripts/rating-audit.ts",
    "decks": "tsx scripts/deck-analysis.ts",
    "saves": "tsx scripts/save-migration-check.ts",
    "events": "tsx scripts/events-check.ts",
    "modes": "tsx scripts/modes-check.ts",
    "arenas": "tsx scripts/arena-check.ts",
    "collection": "tsx scripts/collection-check.ts",
    "anims": "tsx scripts/anim-check.ts",
    "cards": "tsx scripts/cards-check.ts",
    "cardsim": "tsx scripts/card-balance.ts",
    "music": "tsx scripts/music-check.ts",
    "tutorial": "tsx scripts/tutorial-check.ts",
    "lucien": "tsx scripts/lucien-check.ts",
    "graveyard": "tsx scripts/graveyard-check.ts",
    "primeid": "tsx scripts/prime-id-check.ts",
    "accounts": "tsx scripts/account-check.ts",
    "backend": "tsx scripts/backend.ts start",
    "backend:install": "tsx scripts/backend.ts install",
    "backend:stop": "tsx scripts/backend.ts stop",
    "backend:status": "tsx scripts/backend.ts status",
    "backend:backup": "tsx scripts/backend.ts backup",
    "backend:rules": "tsx scripts/backend.ts rules",
    "backend:test": "tsx scripts/backend-check.ts",
    "invites": "tsx scripts/backend.ts invites",
    "backend:migrate-check": "tsx scripts/backend.ts migrate-check",
    "beta:test": "tsx scripts/closed-beta-check.ts",
    "cloud:test": "tsx scripts/cloud-check.ts",
    "server:bundle": "tsx scripts/server-bundle.ts",
    "publish:sync": "tsx scripts/publish-sync.ts"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "pocketbase": "0.28.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
