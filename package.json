{
  "name": "prime-time-showdown",
  "private": true,
  "version": "1.3.0-alpha",
  "description": "PRIME TIME: SHOWDOWN — stylized 3D tactical card duel browser game (Alpha 1.3: Game Modes Expansion)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/simulate.ts",
    "audit": "tsx scripts/rating-audit.ts",
    "decks": "tsx scripts/deck-analysis.ts",
    "saves": "tsx scripts/save-migration-check.ts",
    "events": "tsx scripts/events-check.ts",
    "modes": "tsx scripts/modes-check.ts"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
